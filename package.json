  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test/**",
      "!src/configuration/**",
      "!src/uploads/**"
    ],
    "testMatch": [
      "src/test/**/*.test.js"
    ]
  },
  "bugs": {
    "url": "https://github.com/KatieChiu/APIRestExpertos/issues"
